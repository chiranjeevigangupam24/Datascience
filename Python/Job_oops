from datetime import date


class JobApplication:
    def __init__(self, company, role, required_skills):
        self.company = company
        self.role = role
        self.required_skills = set(required_skills)
        self._status = "Applied"
        self.applied_date = date.today()

    @property
    def status(self):
        return self._status

    def update_status(self, new_status):
        valid_statuses = {
            "Applied",
            "Assessment",
            "Interview",
            "Selected",
            "Rejected"
        }

        if new_status not in valid_statuses:
            raise ValueError("Invalid application status")

        self._status = new_status

    def calculate_skill_match(self, candidate_skills):
        candidate_skills = {
            skill.strip().lower()
            for skill in candidate_skills
        }

        required = {
            skill.lower()
            for skill in self.required_skills
        }

        if not required:
            return 0.0

        matched = required.intersection(candidate_skills)

        return round(len(matched) / len(required) * 100, 2)

    def display(self):
        print(f"Company: {self.company}")
        print(f"Role: {self.role}")
        print(f"Status: {self.status}")
        print(f"Applied Date: {self.applied_date}")


class JobTracker:
    def __init__(self):
        self.applications = []

    def add_application(self, application):
        self.applications.append(application)

    def show_applications(self):
        if not self.applications:
            print("No job applications found.")
            return

        for application in self.applications:
            application.display()
            print("-" * 30)

    def search_by_company(self, company):
        return [
            app for app in self.applications
            if company.lower() in app.company.lower()
        ]


# Create objects
tracker = JobTracker()

candidate_skills = [
    "Python",
    "SQL",
    "OOP",
    "Git"
]

job1 = JobApplication(
    "Infosys",
    "Python Developer",
    ["Python", "SQL", "OOP", "Django"]
)

job2 = JobApplication(
    "TCS",
    "Software Developer",
    ["Python", "Java", "SQL"]
)

tracker.add_application(job1)
tracker.add_application(job2)

# Display applications
tracker.show_applications()

# Calculate skill matches
print("\nSkill Match Results:")

for application in tracker.applications:
    score = application.calculate_skill_match(candidate_skills)

    print(f"{application.company}: {score}% match")